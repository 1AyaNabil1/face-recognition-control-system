# Configuration for the Flask API, GUI and enrollment script.
# Copy to .env and adjust; every variable is optional (defaults shown).
# Never commit the real .env file.

# --- Storage -----------------------------------------------------------------
# SQLite file holding the face embeddings (biometric data: protect it)
FRCS_DB_PATH=app/database/embeddings.db
# CSV log of successful recognitions (timestamp, name)
FRCS_RECOGNITION_LOG_PATH=logs/recognition_log.csv
# Set to false to stop writing the recognition log
FRCS_LOG_RECOGNITIONS=true

# --- Models ------------------------------------------------------------------
FRCS_YOLO_MODEL_PATH=app/models/yolo/yolov8n-face-lindevs.pt
FRCS_YOLO_CONFIDENCE=0.2
# InsightFace model pack; downloaded into FRCS_INSIGHTFACE_ROOT on first use
FRCS_INSIGHTFACE_MODEL=buffalo_l
FRCS_INSIGHTFACE_ROOT=~/.insightface
FRCS_INSIGHTFACE_DET_SIZE=640

# --- Matching ----------------------------------------------------------------
# Cosine similarity a face must reach to be accepted as an enrolled person
FRCS_MATCH_THRESHOLD=0.6
# Minimum InsightFace detection score for a face crop to be embedded
FRCS_MIN_FACE_QUALITY=0.5

# --- HTTP API ----------------------------------------------------------------
# When set, every endpoint except /api/health requires the header X-API-Key
FRCS_API_KEY=
# Comma-separated origins allowed by CORS; empty disables CORS headers
FRCS_CORS_ORIGINS=
# Maximum decoded image size in bytes (default 10 MB)
FRCS_MAX_IMAGE_BYTES=10485760
# Address for `python -m api.app` (use 0.0.0.0 only behind a proxy/firewall)
FRCS_HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# --- Streamlit client (web/app.py) --------------------------------------------
FRCS_API_URL=http://localhost:5000
